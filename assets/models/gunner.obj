# descent-vk gunner: octagonal body, forward barrel.
# THIS MESH MUST STAY CLOSED. Every edge is shared by exactly two triangles.
# M3 extrudes silhouette edges into stencil shadow volumes and depth-fail
# counting is only correct for a closed mesh; the loader treats an open edge as
# a fatal asset error and prints the offending edge's coordinates.
#
# A mesh made of several shells is fine - two disjoint closed shells satisfy the
# rule as well as one does, and their shadow volumes simply overlap, which
# depth-fail counts correctly.
#
# -Z is forward. Wound counter-clockwise seen from outside; normals are not
# authored, the loader computes flat per-face normals.

v    1.500    1.500    0.000
v    1.061    1.500    1.061
v    0.000    1.500    1.500
v   -1.061    1.500    1.061
v   -1.500    1.500    0.000
v   -1.061    1.500   -1.061
v   -0.000    1.500   -1.500
v    1.061    1.500   -1.061
v    1.750   -1.500    0.000
v    1.237   -1.500    1.237
v    0.000   -1.500    1.750
v   -1.237   -1.500    1.237
v   -1.750   -1.500    0.000
v   -1.237   -1.500   -1.237
v   -0.000   -1.500   -1.750
v    1.237   -1.500   -1.237
v    0.420   -0.250    0.000
v    0.210    0.114    0.000
v   -0.210    0.114    0.000
v   -0.420   -0.250    0.000
v   -0.210   -0.614    0.000
v    0.210   -0.614    0.000
v    0.420   -0.250   -4.800
v    0.210    0.114   -4.800
v   -0.210    0.114   -4.800
v   -0.420   -0.250   -4.800
v   -0.210   -0.614   -4.800
v    0.210   -0.614   -4.800

vt 0.00 0.00
vt 1.00 0.00
vt 1.00 1.00

f 1/1 10/2 9/3
f 1/1 2/2 10/3
