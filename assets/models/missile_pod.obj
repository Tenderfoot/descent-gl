# descent-vk missile_pod: the gunner's shoulder launcher. A robot attachment,
# not a robot: AttachmentDef::model names it, and it is drawn, shadowed and hit
# on its own so that it can be shot off.
# THIS MESH MUST STAY CLOSED. Every edge is shared by exactly two triangles.
# It is six closed boxes - the launcher body, four tubes out of its front and
# the strut it stands on - which overlap without sharing a vertex; disjoint
# closed shells satisfy the rule and their shadow volumes overlap, which
# depth-fail counts correctly.
#
# Modelled about its own origin, which AttachmentDef::mount places in the
# robot's space. -Z is forward and the tubes end at z = -1.25. Its bounds are
# its hitbox: see resolveRobotAttachments. Wound counter-clockwise seen from
# outside; normals are not authored, the loader computes flat per-face normals.

# launcher body
v   -0.550   -0.500   -1.000
v    0.550   -0.500   -1.000
v    0.550    0.500   -1.000
v   -0.550    0.500   -1.000
v   -0.550   -0.500    1.000
v    0.550   -0.500    1.000
v    0.550    0.500    1.000
v   -0.550    0.500    1.000
# tube, top left
v   -0.400    0.050   -1.250
v   -0.100    0.050   -1.250
v   -0.100    0.350   -1.250
v   -0.400    0.350   -1.250
v   -0.400    0.050   -0.900
v   -0.100    0.050   -0.900
v   -0.100    0.350   -0.900
v   -0.400    0.350   -0.900
# tube, top right
v    0.100    0.050   -1.250
v    0.400    0.050   -1.250
v    0.400    0.350   -1.250
v    0.100    0.350   -1.250
v    0.100    0.050   -0.900
v    0.400    0.050   -0.900
v    0.400    0.350   -0.900
v    0.100    0.350   -0.900
# tube, bottom left
v   -0.400   -0.350   -1.250
v   -0.100   -0.350   -1.250
v   -0.100   -0.050   -1.250
v   -0.400   -0.050   -1.250
v   -0.400   -0.350   -0.900
v   -0.100   -0.350   -0.900
v   -0.100   -0.050   -0.900
v   -0.400   -0.050   -0.900
# tube, bottom right
v    0.100   -0.350   -1.250
v    0.400   -0.350   -1.250
v    0.400   -0.050   -1.250
v    0.100   -0.050   -1.250
v    0.100   -0.350   -0.900
v    0.400   -0.350   -0.900
v    0.400   -0.050   -0.900
v    0.100   -0.050   -0.900
# mounting strut
v   -0.200   -0.750   -0.300
v    0.200   -0.750   -0.300
v    0.200   -0.400   -0.300
v   -0.200   -0.400   -0.300
v   -0.200   -0.750    0.300
v    0.200   -0.750    0.300
v    0.200   -0.400    0.300
v   -0.200   -0.400    0.300

vt 0.00 0.00
vt 1.00 0.00
vt 1.00 1.00
vt 0.00 1.00

