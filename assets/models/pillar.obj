# descent-vk pillar: tapered octagonal column, a static shadow caster.
# THIS MESH MUST STAY CLOSED. Every edge is shared by exactly two triangles.
# M3 extrudes silhouette edges into stencil shadow volumes and depth-fail
# counting is only correct for a closed mesh; the loader treats an open edge as
# a fatal asset error and prints the offending edge's coordinates.
#
# Wound counter-clockwise seen from outside. Normals are not authored; the
# loader computes flat per-face normals.

v    1.700    9.000    0.000
v    1.202    9.000    1.202
v    0.000    9.000    1.700
v   -1.202    9.000    1.202
v   -1.700    9.000    0.000
v   -1.202    9.000   -1.202
v   -0.000    9.000   -1.700
v    1.202    9.000   -1.202
v    2.200   -9.000    0.000
v    1.556   -9.000    1.556
v    0.000   -9.000    2.200
v   -1.556   -9.000    1.556
v   -2.200   -9.000    0.000
v   -1.556   -9.000   -1.556
v   -0.000   -9.000   -2.200
v    1.556   -9.000   -1.556

vt 0.00 0.00
vt 1.00 0.00
vt 1.00 1.00

f 1/1 10/2 9/3
f 1/1 2/2 10/3
f 2/1 11/2 10/3
f 2/1 3/2 11/3
f 3/1 12/2 11/3
f 3/1 4/2 12/3
f 4/1 13/2 12/3
f 4/1 5/2 13/3
f 5/1 14/2 13/3
f 5/1 6/2 14/3
f 6/1 15/2 14/3
f 6/1 7/2 15/3
f 7/1 16/2 15/3
f 7/1 8/2 16/3
f 8/1 9/2 16/3
f 8/1 1/2 9/3
f 1/1 3/2 2/3
f 1/1 4/2 3/3
f 1/1 5/2 4/3
f 1/1 6/2 5/3
f 1/1 7/2 6/3
f 1/1 8/2 7/3
f 9/1 10/2 11/3
f 9/1 11/2 12/3
f 9/1 12/2 13/3
f 9/1 13/2 14/3
f 9/1 14/2 15/3
f 9/1 15/2 16/3
