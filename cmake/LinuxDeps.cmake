# Dependency resolution for builds that do not go through vcpkg.
#
# The shipping build is MSVC + vcpkg (see CMakePresets.json). This module is
# the equivalent for a Linux dev container, used only so the project can be
# compiled and smoke-run outside Windows. It defines exactly the same target
# names the vcpkg path provides, so nothing under src/ has to know which one
# is in use:
#
#   glfw  glad::glad  glm::glm  imgui::imgui
#   nlohmann_json::nlohmann_json  tinyobjloader::tinyobjloader  ${Stb_INCLUDE_DIR}
#
# glad and Dear ImGui are not packaged usably on Debian/Ubuntu (no glad at all;
# imgui ships without the glfw and opengl3 backend sources), so tools/linux-deps.sh
# fetches those two into .deps/, which is git-ignored. Everything else is a
# distribution package. The dependency set is unchanged from the allowlist in
# CLAUDE.md; only where it is fetched from differs.

set(DVK_DEPS "${CMAKE_SOURCE_DIR}/.deps")

if(NOT EXISTS "${DVK_DEPS}/glad/src/gl.c" OR NOT EXISTS "${DVK_DEPS}/imgui/imgui.cpp")
    message(FATAL_ERROR
        "Vendored dependencies are missing. Run tools/linux-deps.sh first.")
endif()

find_package(glfw3 CONFIG REQUIRED)
find_package(glm QUIET)          # Debian's glm has no config in 0.9.9; header-only either way.
find_package(nlohmann_json CONFIG REQUIRED)
find_package(tinyobjloader CONFIG REQUIRED)

find_path(Stb_INCLUDE_DIR NAMES stb_image.h PATH_SUFFIXES stb REQUIRED)

find_package(OpenGL REQUIRED)

if(NOT TARGET glm::glm)
    add_library(glm_headers INTERFACE)
    target_include_directories(glm_headers SYSTEM INTERFACE /usr/include)
    add_library(glm::glm ALIAS glm_headers)
endif()

# glad: generated by tools/linux-deps.sh with glad2, plus a small glad1-named
# shim header so the single call site in main.cpp is identical on both paths.
# Compiled as C++ so the project stays a CXX-only CMake project.
set_source_files_properties("${DVK_DEPS}/glad/src/gl.c" PROPERTIES LANGUAGE CXX)
add_library(glad_gl STATIC "${DVK_DEPS}/glad/src/gl.c")
target_include_directories(glad_gl SYSTEM PUBLIC "${DVK_DEPS}/glad/include")
target_link_libraries(glad_gl PUBLIC ${CMAKE_DL_LIBS})
add_library(glad::glad ALIAS glad_gl)

# Dear ImGui, core plus only the two backends the project uses.
add_library(imgui_lib STATIC
    "${DVK_DEPS}/imgui/imgui.cpp"
    "${DVK_DEPS}/imgui/imgui_draw.cpp"
    "${DVK_DEPS}/imgui/imgui_tables.cpp"
    "${DVK_DEPS}/imgui/imgui_widgets.cpp"
    "${DVK_DEPS}/imgui/imgui_demo.cpp"
    "${DVK_DEPS}/imgui/backends/imgui_impl_glfw.cpp"
    "${DVK_DEPS}/imgui/backends/imgui_impl_opengl3.cpp"
)
target_include_directories(imgui_lib SYSTEM PUBLIC
    "${DVK_DEPS}/imgui"
    "${DVK_DEPS}/imgui/backends"
)
target_link_libraries(imgui_lib PUBLIC glfw)
add_library(imgui::imgui ALIAS imgui_lib)
